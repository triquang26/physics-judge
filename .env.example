# Copy to .env and fill in. No variable here has a hardcoded fallback, so
# an unset one raises immediately and names itself.
#
# The CLI reads the process environment and does not parse this file. Export it
# once per shell before any kinescore command:
#
#     set -a; . .env; set +a
#
# Point every path at ordinary disk. A RAM disk such as /dev/shm looks fast,
# loses the tree on reboot, and is small enough that a full cache fills it.

# URDF and mesh trees (never vendored -- GR-1 alone is ~285 MB)
KINESCORE_ASSETS=

# Trained reader checkpoints
KINESCORE_CKPT_DIR=

# Backbone feature caches
KINESCORE_CACHE_DIR=

# Everything `kinescore pull` writes, plus the train trees built from it:
#   $KINESCORE_DATA_ROOT/bench/     clips + manifest.json  (video_gen_physics)
#   $KINESCORE_DATA_ROOT/corpus/    training corpora       (vgp_datasets)
#   $KINESCORE_DATA_ROOT/trees/     one train tree per reader
#   $KINESCORE_DATA_ROOT/REVISIONS.json
KINESCORE_DATA_ROOT=

# Scoring outputs (optional; defaults to ./out)
KINESCORE_OUTPUT_DIR=

# Vision-language model weights for `kinescore vlm`
KINESCORE_MODEL_DIR=

# Keep every cache off the small root volume.
# HF_HOME=/mnt/data/.../hf_cache
# TORCH_HOME=/mnt/data/.../torch
# ROBOT_DESCRIPTIONS_CACHE=/mnt/data/.../robot_descriptions
# PYTHONNOUSERSITE=1
