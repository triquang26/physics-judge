# Copy to .env and fill in. Nothing here has a hardcoded fallback: an unset
# variable raises immediately and names itself, rather than silently resolving
# to a path that exists on someone else's machine.

# URDF and mesh trees (never vendored -- GR-1 alone is ~285 MB)
KINESCORE_ASSETS=

# Trained pose-reader checkpoints
KINESCORE_CKPT_DIR=

# Precomputed backbone feature caches
KINESCORE_CACHE_DIR=

# Video clips to score
KINESCORE_DATA_ROOT=

# Scoring outputs (optional; defaults to ./out)
KINESCORE_OUTPUT_DIR=

# Keep every cache off the small root volume.
# HF_HOME=/mnt/data/.../hf_cache
# TORCH_HOME=/mnt/data/.../torch
# ROBOT_DESCRIPTIONS_CACHE=/mnt/data/.../robot_descriptions
# PYTHONNOUSERSITE=1
